# React Native / Expo / CocoaPods expect a flat, npm-style node_modules.
node-linker=hoisted

# Hypersolid policy: no lifecycle scripts on install (patch is applied via
# pnpm patchedDependencies, not a postinstall hook), and new package releases
# must be at least 3 days old before they resolve.
ignore-scripts=true
minimum-release-age=4320
