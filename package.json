{
  "name": "gitbar",
  "version": "1.14.0",
  "private": true,
  "scripts": {
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "codegen": "graphql-codegen --config codegen.ts",
    "format": "eslint --ext=js,jsx,ts,tsx --fix src && prettier --write src ",
    "lint:eslint": "eslint --ext=js,jsx,ts,tsx --max-warnings=0 src",
    "lint:prettier": "prettier --check --loglevel=warn src",
    "lint:tsc": "tsc --noEmit",
    "lint": "concurrently --kill-others-on-fail \"npm:lint:*\"",
    "mac": "react-native run-macos --scheme=GitBar",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "start": "expo start",
    "test": "jest",
    "version:bump": "node scripts/bump-version.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@guava-analytics/react-native": "^0.1.1",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.3.1",
    "@reduxjs/toolkit": "^2.7.0",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.75.2",
    "expo": "^54.0.33",
    "expo-font": "~14.0.11",
    "expo-modules-core": "~3.0.29",
    "graphql": "^16.11.0",
    "js-base64": "^3.7.7",
    "react": "19.1.4",
    "react-intl": "^7.1.11",
    "react-native": "0.81.5",
    "react-native-macos": "0.81.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.15.3",
    "react-native-unistyles": "^2.32.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@babel/runtime": "^7.27.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.8.0",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.4",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "commitlint": "^19.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-triple": "1.1.6",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native-a11y": "^3.3.0",
    "expo-crypto": "~14.1.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.5.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg-transformer": "^1.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@react-navigation/elements": "2.3.0"
  },
  "prettier": "eslint-config-triple/.prettierrc",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "!(.*/**)*.(ts|tsx)": [
      "eslint --max-warnings=0",
      "sh -c 'tsc -p tsconfig.json --noEmit'"
    ],
    "!(.*/**)*.(js|cjs|mjs|jsx)": [
      "eslint --max-warnings=0"
    ]
  }
}
